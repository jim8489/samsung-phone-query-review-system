# SQLite is easiest for local evaluation. PostgreSQL is also supported.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=sqlite:///./data/samsung_phones.db

APP_NAME=Samsung Phone Query & Review System
APP_VERSION=1.2.0
ENVIRONMENT=development
API_PREFIX=/api
SEED_DEMO_DATA=true

# 'auto' tries a local Ollama model and falls back immediately when it is unavailable.
# Use 'ollama' to require the local endpoint, or 'none' to disable LLM calls.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=75

# Be polite to the source website. The scraper enforces at least 2 seconds between requests.
SCRAPER_DELAY_SECONDS=3

SCRAPER_TIMEOUT_SECONDS=25
SCRAPER_MAX_MODELS_PER_RUN=15
SCRAPER_USER_AGENT=SamsungPhoneResearchBot/1.0 (+mailto:jimbosunia2002@gmail.com)
# Optional: protect POST /api/scraper/run with an X-Scraper-Api-Key header.
# SCRAPER_API_KEY=change-this-to-a-long-random-secret
